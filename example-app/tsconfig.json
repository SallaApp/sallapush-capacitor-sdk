{
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@salla.sa/sallapush-capacitor": ["../src/index.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2020",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"]
}
