// Copy this file to SallaPush.local.xcconfig, which git ignores, and set your values.

// snippet:app-id
// The SallaPush app id for iOS, from the Salla team.
SALLAPUSH_APP_ID = your_app_id
// end-snippet

// A bundle id your Apple team can sign.
SALLAPUSH_EXAMPLE_BUNDLE_ID = com.example.sallapush

// Your Apple team, to run on a device.
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Optional: an App Group for the app and the extension. Add the App Groups capability with it to both targets too.
// SALLAPUSH_APP_GROUP = group.com.example.sallapush
