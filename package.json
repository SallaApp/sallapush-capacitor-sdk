{
  "name": "@salla.sa/sallapush-capacitor",
  "version": "1.0.0",
  "description": "SallaPush push notifications for Capacitor apps, built on the SallaPush iOS and Android SDKs.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Salla <mobile@salla.sa> (https://salla.sa)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SallaApp/sallapush-capacitor-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/SallaApp/sallapush-capacitor-sdk/issues"
  },
  "homepage": "https://github.com/SallaApp/sallapush-capacitor-sdk#readme",
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "push",
    "notifications"
  ],
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "dist/**",
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src/main/**",
    "ios/Sources/**",
    "Package.swift",
    "Salla.saSallapushCapacitor.podspec",
    "!**/__tests__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "scripts": {
    "example": "yarn workspace @salla.sa/sallapush-capacitor-example",
    "clean": "del-cli dist",
    "build": "yarn clean && tsc -p tsconfig.build.json && rollup -c rollup.config.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && yarn workspace @salla.sa/sallapush-capacitor-example typecheck",
    "test": "jest",
    "test:scripts": "node --test --test-reporter=tap \"scripts/__tests__/*.test.mjs\""
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@types/node": "^24.19.2",
    "babel-jest": "^29.7.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "workspaces": [
    "example-app"
  ],
  "packageManager": "yarn@4.11.0",
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": "babel-jest"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/example-app/",
      "<rootDir>/dist/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example-app/",
      "<rootDir>/dist/"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/internal/native.ts",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "statements": 90,
        "functions": 90,
        "branches": 80
      }
    }
  }
}
